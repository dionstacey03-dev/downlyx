# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase client configuration (public in the browser bundle; NOT a server secret).
# Set this in local .env.local or deployment build environment.
# Restrict this key to Firebase-required APIs and your deployed HTTP referrers.
# Never allowlist the Gemini Developer API on this public Firebase key.
VITE_FIREBASE_API_KEY="YOUR_RESTRICTED_FIREBASE_API_KEY"

# Optional Firebase Server Verification Settings (never place private credentials here)
FIREBASE_PROJECT_ID=""
FIREBASE_AUTH_EMULATOR_HOST=""
FIREBASE_CHECK_REVOKED="true"

# Production signing secret for short-lived download tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production; must be at least 32 bytes. Never commit the real value.
DOWNLYX_SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES"

# Keep revocation checks strict in production. Requires Firebase Admin IAM permissions.
FIREBASE_STRICT_ADMIN_REVOCATION="true"
