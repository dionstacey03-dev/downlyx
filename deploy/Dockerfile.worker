FROM oven/bun:1-alpine

RUN apk add --no-cache ffmpeg util-linux   && addgroup -S downlyx   && adduser -S -G downlyx downlyx

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY src ./src
COPY server ./server

RUN mkdir -p /tmp/downlyx-media-tmp   && chown -R downlyx:downlyx /app /tmp/downlyx-media-tmp   && chmod 0700 /tmp/downlyx-media-tmp

USER downlyx

ENV NODE_ENV=production
ENV DOWNLYX_WORKER_MODE=1
ENV TMPDIR=/tmp/downlyx-media-tmp

# Container must be run with:
#   --read-only --cap-drop=ALL --security-opt=no-new-privileges:true
#   --network=downlyx-worker-egress --memory=512m --cpus=1.0 --pids-limit=64
ENTRYPOINT ["bun", "run", "server/worker/workerProcess.ts"]
